# ─── Rust / Cargo ────────────────────────────────────────────────────────────
# Cargo.lock is tracked: these crates compile to deployed on-chain wasm, so
# builds must be reproducible byte-for-byte.
/target/
**/*.rs.bk
Cargo.lock.bak

# Regenerated on every `cargo test` run by the Soroban test harness.
**/test_snapshots/

# ─── Node / TypeScript ────────────────────────────────────────────────────────
node_modules/
sdk/dist/
sdk/.turbo/
*.tsbuildinfo
.env
.env.*
!.env.example

# ─── Stellar / Soroban ────────────────────────────────────────────────────────
*.wasm
.stellar/
deployed-contracts.json

# ─── IDE & OS ─────────────────────────────────────────────────────────────────
.DS_Store
.vscode/settings.json
!.vscode/extensions.json
!.vscode/launch.json
*.swp
*.swo
Thumbs.db

# ─── Test artifacts ───────────────────────────────────────────────────────────
coverage/
lcov.info
*.profraw
