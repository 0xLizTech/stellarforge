# Normalize line endings so a Windows checkout cannot commit CRLF into files a
# Linux runner executes or diffs (scripts/deploy.sh fails on `\r`).
#
# `text=auto` is the safety net for any file type not listed below; the
# explicit entries force LF in the index AND in the working tree, whatever a
# contributor's core.autocrlf says.
* text=auto

# Source and docs the issue requires to be LF.
*.sh   text eol=lf
*.rs   text eol=lf
*.ts   text eol=lf
*.md   text eol=lf

# Everything else this repo executes or parses. A CR breaks make recipes, shell
# shebangs and YAML/TOML just as it breaks the files above.
*.cjs   text eol=lf
*.mjs   text eol=lf
*.js    text eol=lf
*.json  text eol=lf
*.toml  text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
Makefile text eol=lf
.gitattributes text eol=lf
.gitignore text eol=lf

# Lockfiles are generated by cargo / npm. GitHub collapses their diffs and
# excludes them from language statistics.
Cargo.lock             text eol=lf linguist-generated=true
package-lock.json      text eol=lf linguist-generated=true
sdk/package-lock.json  text eol=lf linguist-generated=true

# Never touch binary payloads.
*.png  binary
*.jpg  binary
*.gif  binary
*.ico  binary
*.wasm binary
