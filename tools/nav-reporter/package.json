{
  "name": "@stellarforge-protocol/nav-reporter",
  "version": "0.1.0",
  "description": "Signed-appraisal NAV reporter CLI for the StellarForge oracle adapter",
  "bin": {
    "stellarforge-nav-reporter": "./dist/cli.js"
  },
  "main": "dist/index.js",
