# StellarForge — environment template
# Copy to .env and fill in the values you need.
# (.env is gitignored; this file is tracked so the expected keys are documented.)

# ─── Deployment (scripts/deploy.sh) ──────────────────────────────────────────
# Stellar network: mainnet | testnet | futurenet
NETWORK=testnet
# Funded keypair alias used to deploy contracts
STELLAR_ACCOUNT=
# Admin of all four contracts. Defaults to the deploying account; required
# explicitly on mainnet, where it should not be a hot deploy key.
ADMIN=
# rwa-asset metadata. Testnet placeholders apply when unset; on mainnet every
# one is required.
ASSET_NAME=
ASSET_SYMBOL=
ASSET_DECIMALS=
ASSET_CLASS=
# SHA-256 of the legal offering document, as 64 hex digits
ASSET_LEGAL_DOC_HASH=
# Supply cap in base units; 0 = uncapped
ASSET_MAX_SUPPLY=

# ─── SDK (StellarForgeConfig) ────────────────────────────────────────────────
# Soroban RPC endpoint
SOROBAN_RPC_URL=https://soroban-testnet.stellar.org
# Stellar network passphrase
STELLAR_NETWORK_PASSPHRASE="Test SDF Network ; September 2015"
# Optional: fee-paying keypair secret (server-side use only — never commit)
SIGNER_SECRET=

# ─── Live smoke test (sdk/tests/smoke.testnet.test.ts) ───────────────────────
# Opt-in only: each block skips unless its contract id is set, so CI never
# runs them. `make deploy-testnet` writes these ids to deployed-contracts.json.
# Reuses SOROBAN_RPC_URL and STELLAR_NETWORK_PASSPHRASE above.
SMOKE_RWA_ASSET_ID=
SMOKE_COMPLIANCE_ID=
# Optional address to query; defaults to a deterministic unfunded one
SMOKE_HOLDER_ADDRESS=

# ─── Live write smoke test (sdk/tests/smoke.write.testnet.test.ts) ────────────
# Opt-in and testnet only. It mints, transfers and burns tokens and spends fees
# on the named contract. See CONTRIBUTING.md for setup and what a run changes.
SMOKE_WRITE_RWA_ASSET_ID=
# Holds the issuer role on that asset
SMOKE_WRITE_ISSUER_SECRET=
# A second funded account; signs transferFrom and burnFrom
SMOKE_WRITE_SPENDER_SECRET=
# Receives the transfers; needs no account
SMOKE_WRITE_RECIPIENT_ADDRESS=
# "true" when the asset screens transfers, to assert the rejection path too
SMOKE_WRITE_SCREENED=
